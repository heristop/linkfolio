{
  "name": "linkfolio",
  "version": "3.1.1",
  "description": "Self-hosted, open-source Linktree alternative built with Next.js and Tailwind CSS — one fast, accessible link-in-bio page on your own domain.",
  "keywords": [
    "bento",
    "bio-link",
    "bio-link-page",
    "dark-mode",
    "landing-page",
    "link-hub",
    "link-in-bio",
    "link-in-bio-template",
    "linkfolio",
    "linktree",
    "linktree-alternative",
    "next.js",
    "nextjs",
    "open-source",
    "portfolio",
    "react",
    "self-hosted",
    "self-hosted-linktree",
    "tailwind",
    "template",
    "typescript"
  ],
  "homepage": "https://linkfolio-demo.vercel.app",
  "license": "MIT",
  "author": "Alexandre Mogère (heristop)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heristop/linkfolio.git"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./seo": {
      "import": {
        "types": "./dist/seo.d.mts",
        "default": "./dist/seo.mjs"
      },
      "require": {
        "types": "./dist/seo.d.cts",
        "default": "./dist/seo.cjs"
      }
    },
    "./themes": {
      "import": {
        "types": "./dist/themes.d.mts",
        "default": "./dist/themes.mjs"
      },
      "require": {
        "types": "./dist/themes.d.cts",
        "default": "./dist/themes.cjs"
      }
    },
    "./assets": "./dist/assets/index.ts",
    "./assets/globals.css": "./dist/assets/globals.css",
    "./dist/assets": "./dist/assets/index.ts",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:package": "sh ./scripts/build.sh",
    "prepublishOnly": "pnpm run build:package",
    "start": "next start",
    "lint": "oxlint --ignore-pattern=.claude/**",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "gen:readme": "node scripts/gen-readme.ts",
    "indexnow": "node scripts/indexnow.ts",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:package": "pnpm run build:package && node --test tests/package-assets.test.mjs",
    "test:update": "playwright test --update-snapshots",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-nullish-coalescing-operator": "^8.0.1",
    "@playwright/test": "^1.63.0",
    "@swc/core": "^1.16.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.13.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "next": "16.3.8",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.3",
    "tailwindcss": "^4.3.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.21.0"
}
